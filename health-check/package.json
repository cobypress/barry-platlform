{
  "name": "health-check",
  "version": "0.1.0",
  "private": true,
  "description": "Black Cloud Barometer: Salesforce health check engine",
  "type": "module",
  "engines": { "node": ">=24" },
  "bin": { "hc": "src/cli/hc.ts" },
  "scripts": {
    "hc": "node src/cli/hc.ts",
    "test": "node --test \"src/**/__tests__/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "fixtures": "node src/testing/record-fixtures.ts",
    "sample": "node src/render/sample.ts",
    "questions": "node src/facts/questions-report.ts",
    "scale": "node --max-old-space-size=12288 src/testing/scale-run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@fontsource/poppins": "^5.3.0",
    "docx": "^9.15.1",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9.3"
  }
}
