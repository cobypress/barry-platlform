<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>BT_Score_In_Range</fullName>
    <active>true</active>
    <description>Scores run from 0 to 100.</description>
    <errorConditionFormula>BT_Score__c &lt; 0 || BT_Score__c &gt; 100</errorConditionFormula>
    <errorMessage>The score must be between 0 and 100.</errorMessage>
</ValidationRule>
